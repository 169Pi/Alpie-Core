### @sundayfridayabimaje-design — Content Loop
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Sunday Friday Abimaje — Content strategist and designer. A content loop where audience feedback shapes every next idea.">
  <meta name="theme-color" content="#0F0F13">
  <title>Sunday Friday Abimaje — Content Loop</title>

  <style>
    /* === VARIABLES & BASE STYLES === */
    :root {
      --color-idea:       #6C5CE7;
      --color-draft:      #0984E3;
      --color-publish:    #00B894;
      --color-engage:     #E17055;
      --color-bg:         #0F0F13;
      --color-surface:    #17171E;
      --color-surface-2:  #1E1E28;
      --color-border:     rgba(255,255,255,0.07);
      --color-text:       #E8E8F0;
      --color-muted:      #8888A0;
      --color-faint:      #44445A;
      --font-primary:     'Inter', 'Segoe UI', system-ui, sans-serif;
      --spacing-xs:       8px;
      --spacing-sm:       16px;
      --spacing-md:       24px;
      --spacing-lg:       40px;
      --spacing-xl:       64px;
      --radius-sm:        8px;
      --radius-md:        14px;
      --radius-lg:        20px;
      --transition:       220ms ease-in-out;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-primary);
      background-color: var(--color-bg);
      color: var(--color-text);
      font-size: 15px;
      line-height: 1.6;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* === TYPOGRAPHY === */
    h1 {
      font-size: clamp(28px, 5vw, 46px);
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: -0.5px;
    }

    h2 {
      font-size: clamp(18px, 3vw, 26px);
      font-weight: 600;
      line-height: 1.3;
    }

    h3 {
      font-size: 16px;
      font-weight: 600;
      line-height: 1.4;
    }

    p {
      color: var(--color-muted);
      line-height: 1.7;
    }

    /* === LAYOUT === */
    .page-wrapper {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .container {
      width: 100%;
      max-width: 900px;
      margin: 0 auto;
      padding: 0 var(--spacing-sm);
    }

    /* === HEADER / NAV === */
    .site-header {
      padding: var(--spacing-md) 0;
      border-bottom: 1px solid var(--color-border);
      position: sticky;
      top: 0;
      background-color: rgba(15,15,19,0.88);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      z-index: 100;
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--spacing-sm);
    }

    .wordmark {
      font-size: 14px;
      font-weight: 600;
      color: var(--color-text);
      letter-spacing: 0.3px;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .wordmark-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--color-idea), var(--color-draft));
      display: inline-block;
      flex-shrink: 0;
    }

    .header-link {
      font-size: 13px;
      color: var(--color-muted);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: color var(--transition);
      border: 1px solid var(--color-border);
      padding: 6px 14px;
      border-radius: 40px;
    }

    .header-link:hover {
      color: var(--color-text);
      border-color: rgba(255,255,255,0.16);
    }

    .header-link:focus-visible {
      outline: 2px solid var(--color-draft);
      outline-offset: 3px;
    }

    /* === HERO SECTION === */
    .hero {
      padding: var(--spacing-xl) 0 var(--spacing-lg);
      text-align: center;
    }

    .hero-tag {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      font-weight: 500;
      color: var(--color-muted);
      letter-spacing: 0.8px;
      text-transform: uppercase;
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: 5px 14px;
      border-radius: 40px;
      margin-bottom: var(--spacing-md);
    }

    .hero-tag-pulse {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--color-publish);
      position: relative;
      flex-shrink: 0;
    }

    .hero-tag-pulse::after {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: 50%;
      background: var(--color-publish);
      opacity: 0.3;
      animation: pulse 2.2s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 0.3; }
      50%       { transform: scale(1.9); opacity: 0; }
    }

    .hero-name {
      margin-bottom: var(--spacing-xs);
    }

    .hero-name-accent {
      background: linear-gradient(135deg, var(--color-idea) 0%, var(--color-draft) 50%, var(--color-publish) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-subtitle {
      font-size: clamp(14px, 2.5vw, 18px);
      color: var(--color-muted);
      max-width: 480px;
      margin: var(--spacing-sm) auto 0;
      line-height: 1.7;
    }

    /* === LOOP DIAGRAM === */
    .loop-section {
      padding: var(--spacing-lg) 0;
    }

    .loop-card {
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--spacing-lg) var(--spacing-md);
      position: relative;
      overflow: hidden;
    }

    .loop-card::before {
      content: '';
      position: absolute;
      top: -60px;
      left: 50%;
      transform: translateX(-50%);
      width: 300px;
      height: 120px;
      background: radial-gradient(ellipse, rgba(108,92,231,0.12) 0%, transparent 70%);
      pointer-events: none;
    }

    .loop-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--color-faint);
      text-align: center;
      margin-bottom: var(--spacing-md);
    }

    /* === ANIMATED LOOP NODES === */
    .loop-nodes {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      flex-wrap: nowrap;
      overflow-x: auto;
      padding: var(--spacing-xs) 0;
      scrollbar-width: none;
    }

    .loop-nodes::-webkit-scrollbar {
      display: none;
    }

    .node-group {
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }

    .node {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      cursor: default;
    }

    .node-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      border-radius: 40px;
      font-size: 14px;
      font-weight: 600;
      color: #fff;
      position: relative;
      transition: transform var(--transition), box-shadow var(--transition);
      white-space: nowrap;
    }

    .node-pill:hover {
      transform: translateY(-2px);
    }

    .node-pill.idea {
      background: var(--color-idea);
      box-shadow: 0 4px 20px rgba(108,92,231,0.35);
    }

    .node-pill.draft {
      background: var(--color-draft);
      box-shadow: 0 4px 20px rgba(9,132,227,0.35);
    }

    .node-pill.publish {
      background: var(--color-publish);
      box-shadow: 0 4px 20px rgba(0,184,148,0.35);
    }

    .node-pill.engage {
      background: var(--color-engage);
      box-shadow: 0 4px 20px rgba(225,112,85,0.35);
    }

    .node-icon {
      font-size: 16px;
      line-height: 1;
    }

    .node-caption {
      font-size: 11px;
      color: var(--color-faint);
      letter-spacing: 0.3px;
      text-align: center;
    }

    /* Arrow connector */
    .node-arrow {
      width: 28px;
      height: 2px;
      background: var(--color-faint);
      position: relative;
      flex-shrink: 0;
      margin: 0 2px;
      margin-bottom: 22px;
    }

    .node-arrow::after {
      content: '';
      position: absolute;
      right: -1px;
      top: 50%;
      transform: translateY(-50%);
      border: 5px solid transparent;
      border-left-color: var(--color-faint);
    }

    /* Animated active node indicator */
    .node-active-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: rgba(255,255,255,0.6);
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      animation: travel 3.6s ease-in-out infinite;
      pointer-events: none;
    }

    @keyframes travel {
      0%   { left: 0;   opacity: 0; }
      10%  { opacity: 1; }
      90%  { opacity: 1; }
      100% { left: calc(100% - 5px); opacity: 0; }
    }

    /* Feedback loop arc */
    .loop-feedback {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: var(--spacing-md);
      gap: 8px;
    }

    .loop-arc-container {
      width: 100%;
      max-width: 520px;
      overflow: visible;
    }

    .loop-feedback-text {
      font-size: 12px;
      color: var(--color-faint);
      letter-spacing: 0.4px;
      font-style: italic;
    }

    /* === PHILOSOPHY SECTION === */
    .philosophy-section {
      padding: var(--spacing-lg) 0;
    }

    .philosophy-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--spacing-sm);
    }

    .philosophy-card {
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: var(--spacing-md);
      display: flex;
      gap: var(--spacing-sm);
      transition: border-color var(--transition), background-color var(--transition);
    }

    .philosophy-card:hover {
      background-color: var(--color-surface-2);
      border-color: rgba(255,255,255,0.12);
    }

    .philosophy-icon-wrap {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      flex-shrink: 0;
    }

    .icon-idea   { background: rgba(108,92,231,0.15); }
    .icon-draft  { background: rgba(9,132,227,0.15);  }
    .icon-publish{ background: rgba(0,184,148,0.15);  }
    .icon-engage { background: rgba(225,112,85,0.15); }

    .philosophy-body h3 {
      color: var(--color-text);
      margin-bottom: 4px;
    }

    .philosophy-body p {
      font-size: 14px;
    }

    /* === GITHUB CTA === */
    .cta-section {
      padding: var(--spacing-lg) 0 var(--spacing-xl);
      text-align: center;
    }

    .cta-inner {
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--spacing-lg) var(--spacing-md);
    }

    .cta-eyebrow {
      font-size: 12px;
      color: var(--color-faint);
      letter-spacing: 0.8px;
      text-transform: uppercase;
      margin-bottom: var(--spacing-xs);
    }

    .cta-heading {
      font-size: clamp(18px, 3vw, 26px);
      font-weight: 700;
      color: var(--color-text);
      margin-bottom: var(--spacing-xs);
    }

    .cta-sub {
      font-size: 14px;
      color: var(--color-muted);
      margin-bottom: var(--spacing-md);
    }

    .cta-button {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background-color: var(--color-text);
      color: var(--color-bg);
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      padding: 12px 28px;
      border-radius: 40px;
      transition: background-color var(--transition), transform var(--transition), box-shadow var(--transition);
      border: none;
      cursor: pointer;
    }

    .cta-button:hover {
      background-color: #ffffff;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.35);
    }

    .cta-button:focus-visible {
      outline: 2px solid var(--color-draft);
      outline-offset: 3px;
    }

    .cta-button svg {
      flex-shrink: 0;
    }

    /* === FOOTER === */
    .site-footer {
      border-top: 1px solid var(--color-border);
      padding: var(--spacing-md) 0;
      margin-top: auto;
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--spacing-sm);
      flex-wrap: wrap;
    }

    .footer-copy {
      font-size: 13px;
      color: var(--color-faint);
    }

    .footer-tag-row {
      display: flex;
      align-items: center;
      gap: var(--spacing-sm);
    }

    .footer-dot-tag {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--color-faint);
    }

    .footer-dot-tag span {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    /* === RESPONSIVE MEDIA QUERIES === */

    /* Tablet: 640px and up */
    @media (min-width: 640px) {
      .container {
        padding: 0 var(--spacing-md);
      }

      .loop-card {
        padding: var(--spacing-xl) var(--spacing-lg);
      }

      .philosophy-grid {
        grid-template-columns: 1fr 1fr;
      }

      .node-arrow {
        width: 40px;
      }
    }

    /* Desktop: 1024px and up */
    @media (min-width: 1024px) {
      .container {
        padding: 0 var(--spacing-lg);
      }

      .node-arrow {
        width: 52px;
      }

      .node-pill {
        padding: 12px 26px;
        font-size: 15px;
      }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      .hero-tag-pulse::after,
      .node-active-dot {
        animation: none;
      }
      * {
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>

  <div class="page-wrapper">

    <!-- HEADER -->
    <header class="site-header" role="banner">
      <div class="container">
        <div class="header-inner">
          <a href="#" class="wordmark" aria-label="Sunday Friday Abimaje homepage">
            <span class="wordmark-dot" aria-hidden="true"></span>
            Sunday Friday
          </a>
          <a
            href="https://github.com/sundayfridayabimaje-design"
            target="_blank"
            rel="noopener noreferrer"
            class="header-link"
            aria-label="Visit GitHub profile, opens in new tab"
          >
            <!-- GitHub icon -->
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </header>

    <!-- MAIN CONTENT -->
    <main id="main-content">

      <!-- HERO -->
      <section class="hero" aria-labelledby="hero-heading">
        <div class="container">
          <div class="hero-tag" role="status" aria-label="Status: actively creating">
            <span class="hero-tag-pulse" aria-hidden="true"></span>
            Actively Creating
          </div>
          <h1 class="hero-name" id="hero-heading">
            <span class="hero-name-accent">Content Loop</span><br>
            in Motion
          </h1>
          <p class="hero-subtitle">
            Every piece of content I make is shaped by what came before it.
            Audience feedback is not a metric, it is the next idea.
          </p>
        </div>
      </section>

      <!-- LOOP DIAGRAM -->
      <section class="loop-section" aria-labelledby="loop-heading">
        <div class="container">
          <div class="loop-card" role="img" aria-label="Content loop diagram showing four stages: Idea, Draft, Publish, Engage, with feedback looping back to Idea">
            <p class="loop-label" id="loop-heading">The Content Loop</p>

            <!-- NODES ROW -->
            <div class="loop-nodes" role="list">

              <!-- Node: Idea -->
              <div class="node-group" role="listitem">
                <div class="node">
                  <div class="node-pill idea">
                    <span class="node-icon" aria-hidden="true">💡</span>
                    Idea
                  </div>
                  <span class="node-caption">where it starts</span>
                </div>
              </div>

              <!-- Arrow 1 -->
              <div class="node-arrow" aria-hidden="true">
                <span class="node-active-dot" style="animation-delay: 0s;"></span>
              </div>

              <!-- Node: Draft -->
              <div class="node-group" role="listitem">
                <div class="node">
                  <div class="node-pill draft">
                    <span class="node-icon" aria-hidden="true">✍️</span>
                    Draft
                  </div>
                  <span class="node-caption">shape the thought</span>
                </div>
              </div>

              <!-- Arrow 2 -->
              <div class="node-arrow" aria-hidden="true">
                <span class="node-active-dot" style="animation-delay: 0.9s;"></span>
              </div>

              <!-- Node: Publish -->
              <div class="node-group" role="listitem">
                <div class="node">
                  <div class="node-pill publish">
                    <span class="node-icon" aria-hidden="true">🚀</span>
                    Publish
                  </div>
                  <span class="node-caption">put it into the world</span>
                </div>
              </div>

              <!-- Arrow 3 -->
              <div class="node-arrow" aria-hidden="true">
                <span class="node-active-dot" style="animation-delay: 1.8s;"></span>
              </div>

              <!-- Node: Engage -->
              <div class="node-group" role="listitem">
                <div class="node">
                  <div class="node-pill engage">
                    <span class="node-icon" aria-hidden="true">🔁</span>
                    Engage
                  </div>
                  <span class="node-caption">listen and learn</span>
                </div>
              </div>

            </div>
            <!-- END NODES ROW -->

            <!-- FEEDBACK ARC -->
            <div class="loop-feedback" aria-hidden="true">
              <div class="loop-arc-container">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 520 52"
                  width="100%"
                  height="52"
                  aria-hidden="true"
                >
                  <defs>
                    <marker id="fb-arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                      <path d="M0,1 L8,5 L0,9 z" fill="#44445A"/>
                    </marker>
                    <marker id="fb-arrow-glow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                      <path d="M0,1 L8,5 L0,9 z" fill="rgba(108,92,231,0.6)"/>
                    </marker>
                  </defs>
                  <!-- Base arc (muted) -->
                  <path
                    d="M 490,8 Q 490,44 260,44 Q 30,44 30,8"
                    fill="none"
                    stroke="#44445A"
                    stroke-width="1.5"
                    stroke-dasharray="5,5"
                    marker-end="url(#fb-arrow)"
                  />
                  <!-- Animated glow arc -->
                  <path
                    d="M 490,8 Q 490,44 260,44 Q 30,44 30,8"
                    fill="none"
                    stroke="rgba(108,92,231,0.5)"
                    stroke-width="1.5"
                    stroke-dasharray="460"
                    stroke-dashoffset="460"
                    marker-end="url(#fb-arrow-glow)"
                  >
                    <animate
                      attributeName="stroke-dashoffset"
                      from="460"
                      to="-460"
                      dur="4s"
                      repeatCount="indefinite"
                      calcMode="linear"
                    />
                  </path>
                </svg>
              </div>
              <p class="loop-feedback-text">feedback shapes the next idea</p>
            </div>

          </div>
        </div>
      </section>

      <!-- PHILOSOPHY SECTION -->
      <section class="philosophy-section" aria-labelledby="philosophy-heading">
        <div class="container">
          <h2 id="philosophy-heading" style="margin-bottom: var(--spacing-md); color: var(--color-text);">
            How I work
          </h2>
          <div class="philosophy-grid">

            <div class="philosophy-card">
              <div class="philosophy-icon-wrap icon-idea" aria-hidden="true">💡</div>
              <div class="philosophy-body">
                <h3>Intentional Ideas</h3>
                <p>Every piece starts with a question worth answering, not just a topic worth filling.</p>
              </div>
            </div>

            <div class="philosophy-card">
              <div class="philosophy-icon-wrap icon-draft" aria-hidden="true">✍️</div>
              <div class="philosophy-body">
                <h3>Structured Drafts</h3>
                <p>I draft to clarify, not to polish. Clarity first, then craft.</p>
              </div>
            </div>

            <div class="philosophy-card">
              <div class="philosophy-icon-wrap icon-publish" aria-hidden="true">🚀</div>
              <div class="philosophy-body">
                <h3>Consistent Publishing</h3>
                <p>Shipping is the discipline. Waiting for perfect is the enemy of presence.</p>
              </div>
            </div>

            <div class="philosophy-card">
              <div class="philosophy-icon-wrap icon-engage" aria-hidden="true">🔁</div>
              <div class="philosophy-body">
                <h3>Feedback as Fuel</h3>
                <p>Audience response is data. I treat every comment, share, and scroll as a signal.</p>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- GITHUB CTA -->
      <section class="cta-section" aria-labelledby="cta-heading">
        <div class="container">
          <div class="cta-inner">
            <p class="cta-eyebrow">Open work</p>
            <h2 class="cta-heading" id="cta-heading">See it in practice</h2>
            <p class="cta-sub">Explore projects, design work, and the loop in action on GitHub.</p>
            <a
              href="https://github.com/sundayfridayabimaje-design"
              target="_blank"
