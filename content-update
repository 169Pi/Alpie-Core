  <script>
    // === STATE & SELECTORS ===
    const philosophyCards = document.querySelectorAll('.philosophy-card');
    const nodePills = document.querySelectorAll('.node-pill');

    // === UTILITY: Intersection Observer for subtle reveal ===
    function createRevealObserver(elements, className, threshold) {
      if (!('IntersectionObserver' in window)) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add(className);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: threshold || 0.15 });

      elements.forEach(el => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(14px)';
        el.style.transition = 'opacity 380ms ease-out, transform 380ms ease-out';
        observer.observe(el);
      });
    }

    // Reveal class applies visible state
    document.head.insertAdjacentHTML('beforeend', `
      <style>
        .is-visible {
          opacity: 1 !important;
          transform: translateY(0) !important;
        }
      </style>
    `);

    // === EVENT LISTENERS ===

    // Node pill hover: lift sibling nodes slightly for contrast
    nodePills.forEach(pill => {
      pill.addEventListener('mouseenter', () => {
        nodePills.forEach(p => {
          if (p !== pill) {
            p.style.opacity = '0.55';
          }
        });
      });

      pill.addEventListener('mouseleave', () => {
        nodePills.forEach(p => {
          p.style.opacity = '1';
        });
      });
    });

    // === INITIALIZATION ===
    document.addEventListener('DOMContentLoaded', () => {

      // Respect reduced motion preference before applying animations
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReduced) {
        // Staggered reveal for philosophy cards
        philosophyCards.forEach((card, index) => {
          card.style.transitionDelay = `${index * 80}ms`;
        });
        createRevealObserver(philosophyCards, 'is-visible', 0.1);

        // Reveal loop card
        const loopCard = document.querySelector('.loop-card');
        if (loopCard) {
          createRevealObserver([loopCard], 'is-visible', 0.1);
        }

        // Reveal CTA inner
        const ctaInner = document.querySelector('.cta-inner');
        if (ctaInner) {
          createRevealObserver([ctaInner], 'is-visible', 0.2);
        }
      }

    });
  </script>

